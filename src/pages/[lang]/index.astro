---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import Logo from '../../components/Logo.astro';
import { games, gamePath } from '../../data/games';
import { SITE, type Locale } from '../../data/site';
import { getLangStaticPaths, localePath, pick, useTranslations, formatDate } from '../../i18n/utils';
import { getDevlogsFor } from '../../lib/devlogs';

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const hero = games.find((g) => g.featured && g.status === 'released') ?? games[0];
const featured = games.filter((g) => g.featured);
const released = games.filter((g) => g.status === 'released');
const inDev = games.filter((g) => g.status !== 'released');
const updates = (await getDevlogsFor(lang)).slice(0, 3);
---

<BaseLayout lang={lang} title={SITE.name} path="/">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-line">
    <Image
      src={hero.cover.src}
      alt=""
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-bg via-bg/90 to-bg/30" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-bg to-transparent" aria-hidden="true"></div>

    <div class="container-site grid min-h-[34rem] items-center gap-10 py-16 sm:py-24 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <Logo size={52} class="mb-8 !hidden sm:!inline-flex" />
        <h1 class="text-4xl font-bold leading-[1.05] sm:text-6xl">{t('home.hero.title')}</h1>
        <p class="mt-5 max-w-xl text-lg text-muted">{t('home.hero.text')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localePath(lang, '/games/')} class="btn btn-primary">{t('home.hero.explore')}</a>
          <a href={localePath(lang, '/support/')} class="btn btn-ghost">{t('nav.support')}</a>
        </div>
      </div>

      <a
        href={localePath(lang, gamePath(hero))}
        class="card group block overflow-hidden bg-card/80 backdrop-blur-sm transition-colors hover:border-muted/50"
      >
        <div class="aspect-video overflow-hidden">
          <Image
            src={hero.cover.src}
            alt={pick(hero.cover.alt, lang)}
            widths={[480, 720]}
            sizes="(min-width: 1024px) 36vw, 100vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
        <div class="p-5">
          <p class="eyebrow">{t('home.hero.featured')}</p>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <span class="text-xl font-bold">{hero.title}</span>
            <StatusBadge status={hero.status} lang={lang} />
          </div>
          <p class="mt-1.5 text-sm text-muted">{pick(hero.tagline, lang)}</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Featured -->
  <section class="container-site mt-16" aria-labelledby="featured-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="featured-title" class="section-title">{t('home.featured')}</h2>
      <a href={localePath(lang, '/games/')} class="text-sm font-semibold text-muted hover:text-text">{t('home.allGames')} →</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {featured.map((game) => <GameCard game={game} lang={lang} />)}
    </div>
  </section>

  <!-- Released -->
  <section class="container-site mt-16" aria-labelledby="released-title">
    <h2 id="released-title" class="section-title">{t('home.released')}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {released.map((game) => <GameCard game={game} lang={lang} />)}
    </div>
  </section>

  <!-- In development -->
  <section class="container-site mt-16" aria-labelledby="indev-title">
    <h2 id="indev-title" class="section-title">{t('home.indev')}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {inDev.map((game) => <GameCard game={game} lang={lang} />)}
    </div>
  </section>

  <!-- Latest updates -->
  <section class="container-site mt-16" aria-labelledby="updates-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="updates-title" class="section-title">{t('home.updates')}</h2>
      <a href={localePath(lang, '/devlogs/')} class="text-sm font-semibold text-muted hover:text-text">{t('home.allDevlogs')} →</a>
    </div>
    <div class="mt-6">
      {
        updates.length === 0 ? (
          <EmptyState title={t('devlogs.emptyTitle')} text={t('devlogs.emptyText')} />
        ) : (
          <ul class="grid gap-4 md:grid-cols-3">
            {updates.map((u) => (
              <li class="card p-5">
                <time class="text-xs text-muted" datetime={u.entry.data.date.toISOString().slice(0, 10)}>
                  {formatDate(u.entry.data.date.toISOString().slice(0, 10), lang)}
                </time>
                <h3 class="mt-2 font-bold">
                  <a href={localePath(lang, `/devlogs/${u.slug}/`)} class="hover:text-accent-text">
                    {u.entry.data.title}
                  </a>
                </h3>
                <p class="mt-1.5 text-sm text-muted">{u.entry.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Support strip -->
  <section class="container-site mt-16">
    <div class="card flex flex-col items-start justify-between gap-5 p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <h2 class="text-xl font-bold">{t('home.helpTitle')}</h2>
        <p class="mt-1.5 text-muted">{t('home.helpText')}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={localePath(lang, '/support/')} class="btn btn-primary">{t('nav.support')}</a>
        <a href={localePath(lang, '/privacy-policy/')} class="btn btn-ghost">{t('footer.privacy')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

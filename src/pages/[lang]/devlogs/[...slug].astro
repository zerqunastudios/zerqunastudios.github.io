---
import GameImg from '../../../components/GameImg.astro';
import GameStoreLinks from '../../../components/GameStoreLinks.astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { games, gamePath } from '../../../data/games';
import { SITE, type Locale } from '../../../data/site';
import { localePath, useTranslations, formatDate } from '../../../i18n/utils';
import { getDevlogViews, type DevlogView } from '../../../lib/devlogs';

export async function getStaticPaths() {
  const views = await getDevlogViews();
  return views.map((view) => ({ params: { lang: view.lang, slug: view.slug }, props: { view } }));
}

const { view } = Astro.props as { view: DevlogView };
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { entry, isFallback, slug } = view;
const { Content } = await render(entry);
const game = games.find((g) => g.slug === entry.data.game);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const entryLang = entry.id.split('/')[0] as Locale;
const path = `/devlogs/${slug}/`;
const site = Astro.site!;

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: iso(entry.data.date),
  ...(entry.data.updated ? { dateModified: iso(entry.data.updated) } : {}),
  inLanguage: entryLang,
  url: new URL(localePath(entryLang, path), site).href,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  canonicalLang={isFallback ? entryLang : lang}
  type="article"
  image={entry.data.cover}
  imageAlt={entry.data.coverAlt}
  jsonLd={[article]}
>
  <article class="container-site py-12 sm:py-16">
    <a href={localePath(lang, '/devlogs/')} class="text-sm text-muted hover:text-text">← {t('devlogs.back')}</a>
    <header class="mt-6 max-w-3xl">
      <p class="text-sm text-muted">
        {t('devlogs.published')}: <time datetime={iso(entry.data.date)}>{formatDate(iso(entry.data.date), lang)}</time>
        {
          entry.data.updated && (
            <Fragment>
              {' · '}
              {t('devlogs.updated')}: <time datetime={iso(entry.data.updated)}>{formatDate(iso(entry.data.updated), lang)}</time>
            </Fragment>
          )
        }
        {
          game && (
            <Fragment>
              {' · '}
              <a href={localePath(lang, gamePath(game))} class="link">{game.title}</a>
            </Fragment>
          )
        }
      </p>
      <h1 class="mt-3 text-3xl font-bold sm:text-5xl" lang={entryLang}>{entry.data.title}</h1>
      <p class="mt-4 text-lg text-muted" lang={entryLang}>{entry.data.description}</p>
    </header>

    {
      isFallback && (
        <p class="mt-6 max-w-3xl rounded-lg border border-warn/40 bg-warn/10 p-4 text-sm">{t('devlogs.translationMissing')}</p>
      )
    }

    {
      entry.data.cover && (
        <GameImg
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? ''}
          pixelated={entry.data.coverPixelated}
          widths={[720, 1200, 1600]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          loading="eager"
          class="mt-10 aspect-video w-full max-w-5xl rounded-xl border border-line object-cover"
        />
      )
    }

    <div class="prose-site mt-10" lang={entryLang}>
      <Content />
    </div>

    {
      game && game.storeLinks.length > 0 && (
        <aside class="mt-12 max-w-3xl" aria-label={t('devlogs.getGame')}>
          <p class="eyebrow">{t('devlogs.getGame')}</p>
          <GameStoreLinks game={game} lang={lang} variant="section" hideHeading class="mt-3" />
        </aside>
      )
    }

    <p class="mt-10 text-sm">
      <a href={localePath(lang, '/devlogs/')} class="link">← {t('devlogs.back')}</a>
      {
        game && (
          <Fragment>
            {' · '}
            <a href={localePath(lang, gamePath(game))} class="link">{game.title}</a>
          </Fragment>
        )
      }
    </p>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../data/games';
import type { Locale } from '../../data/site';
import { getLangStaticPaths, localePath, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const c = {
  en: {
    intro: 'Zerquna Studios is an independent game development brand making games for Windows PC.',
    whoTitle: 'Who we are',
    who: [
      'Zerquna Studios is the name behind our games. We make games we would like to play ourselves: calm, hands-on simulations like SpinCraft, a sandbox world to build and survive in with Echoes of the Earth, and fast top-down action with VELKRION: THE FIRST BREACH.',
      'We are independent, which means we decide what we make and how we make it. Our games are built step by step, tested on real hardware, and shaped by the feedback of the people who play them.',
    ],
    valuesTitle: 'What we care about',
    values: [
      ['Craft', 'Small details matter: how the wood shavings fly, how a zombie moves, how a village grows.'],
      ['Honesty', 'We only announce what is real. No fake features, no inflated promises.'],
      ['Privacy', 'Our games have no ads, no tracking and no accounts. Your progress stays on your PC.'],
      ['Support', 'Every message to our support address is read. If something breaks, we want to know.'],
    ],
    toolsTitle: 'How we build',
    tools: 'Our games are made with the Unity and Godot engines, with art and audio created in tools such as Blender, Pixelorama and LMMS.',
    gamesTitle: 'Our games',
    contactTitle: 'Get in touch',
    contact: 'For business, press or general questions, see the contact page.',
  },
  tr: {
    intro: 'Zerquna Studios, Windows PC için oyunlar geliştiren bağımsız bir oyun geliştirme markasıdır.',
    whoTitle: 'Biz kimiz',
    who: [
      'Zerquna Studios, oyunlarımızın arkasındaki isimdir. Kendimizin de oynamak isteyeceği oyunlar yapıyoruz: SpinCraft gibi sakin ve el emeğine dayalı simülasyonlar, Echoes of the Earth ile inşa edip hayatta kalınacak bir sandbox dünyası ve VELKRION: THE FIRST BREACH ile hızlı, kuşbakışı aksiyon.',
      'Bağımsızız; yani ne yapacağımıza ve nasıl yapacağımıza kendimiz karar veriyoruz. Oyunlarımızı adım adım geliştiriyor, gerçek donanımlarda test ediyor ve onları oynayan insanların geri bildirimleriyle şekillendiriyoruz.',
    ],
    valuesTitle: 'Önem verdiklerimiz',
    values: [
      ['Ustalık', 'Küçük ayrıntılar önemlidir: talaşların nasıl uçtuğu, bir zombinin nasıl hareket ettiği, bir köyün nasıl büyüdüğü.'],
      ['Dürüstlük', 'Yalnızca gerçek olanı duyururuz. Sahte özellik yok, abartılı vaat yok.'],
      ['Gizlilik', 'Oyunlarımızda reklam, izleme veya hesap yoktur. İlerlemeniz bilgisayarınızda kalır.'],
      ['Destek', 'Destek adresimize gelen her mesaj okunur. Bir şey bozulursa bunu bilmek isteriz.'],
    ],
    toolsTitle: 'Nasıl geliştiriyoruz',
    tools: 'Oyunlarımızı Unity ve Godot motorlarıyla geliştiriyor; görselleri ve sesleri Blender, Pixelorama ve LMMS gibi araçlarla üretiyoruz.',
    gamesTitle: 'Oyunlarımız',
    contactTitle: 'Bize ulaşın',
    contact: 'İş birliği, basın veya genel sorularınız için iletişim sayfasına göz atın.',
  },
}[lang];
---

<BaseLayout lang={lang} title={t('nav.about')} description={c.intro} path="/about/">
  <PageHeader title={t('nav.about')} intro={c.intro} />

  <div class="container-site mt-12 space-y-16">
    <section class="grid gap-8 lg:grid-cols-[1fr_1fr]" aria-labelledby="who">
      <div>
        <h2 id="who" class="section-title">{c.whoTitle}</h2>
        <div class="mt-4 space-y-4 leading-relaxed text-[#d9dce3]">
          {c.who.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <h2 class="section-title">{c.valuesTitle}</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            c.values.map(([k, v]) => (
              <div class="card p-4">
                <dt class="font-bold text-accent-text">{k}</dt>
                <dd class="mt-1 text-sm text-muted">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-labelledby="tools">
      <h2 id="tools" class="section-title">{c.toolsTitle}</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-[#d9dce3]">{c.tools}</p>
    </section>

    <section aria-labelledby="our-games">
      <h2 id="our-games" class="section-title">{c.gamesTitle}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {games.map((g) => <GameCard game={g} lang={lang} />)}
      </div>
    </section>

    <section class="card flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center" aria-labelledby="get-in-touch">
      <div>
        <h2 id="get-in-touch" class="text-xl font-bold">{c.contactTitle}</h2>
        <p class="mt-1 text-muted">{c.contact}</p>
      </div>
      <a href={localePath(lang, '/contact/')} class="btn btn-primary">{t('nav.contact')}</a>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import GameStoreLinks from '../../components/GameStoreLinks.astro';
import { games, gamePath } from '../../data/games';
import type { Locale } from '../../data/site';
import { getLangStaticPaths, localePath, pick, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const downloads = games.flatMap((g) => g.downloads.map((d) => ({ game: g, ...d })));
// Games that have a demo or release but no published download link yet.
const pending = games.filter((g) => g.status !== 'in-development' && g.downloads.length === 0 && g.storeLinks.length === 0);
// Games offered on a store page but without a separate free download (e.g. a paid release).
const storeOnly = games.filter((g) => g.downloads.length === 0 && g.storeLinks.length > 0);
---

<BaseLayout lang={lang} title={t('downloads.title')} description={t('downloads.intro')} path="/downloads/">
  <PageHeader title={t('downloads.title')} intro={t('downloads.intro')} />

  <section class="container-site mt-10 space-y-8">
    {
      downloads.length > 0 ? (
        <div class="sm:overflow-x-auto sm:rounded-[0.875rem] sm:border sm:border-line sm:bg-card">
          <table class="stack-table w-full text-left text-sm">
            <thead class="border-b border-line text-muted">
              <tr>
                <th scope="col" class="p-4 font-semibold">{t('nav.games')}</th>
                <th scope="col" class="p-4 font-semibold">{t('downloads.version')}</th>
                <th scope="col" class="p-4 font-semibold">{t('downloads.platform')}</th>
                <th scope="col" class="p-4 font-semibold">{t('downloads.source')}</th>
                <th scope="col" class="p-4 font-semibold">{t('downloads.size')}</th>
                <th scope="col" class="p-4"><span class="sr-only">{t('downloads.get')}</span></th>
              </tr>
            </thead>
            <tbody>
              {downloads.map((d) => (
                <tr class="border-b border-line last:border-0">
                  <td class="p-4" data-label={t('nav.games')}>
                    <a href={localePath(lang, gamePath(d.game))} class="font-semibold hover:text-accent-text">{d.game.title}</a>
                    <div class="text-muted">{pick(d.title, lang)}</div>
                  </td>
                  <td class="p-4" data-label={t('downloads.version')}>{d.version}</td>
                  <td class="p-4" data-label={t('downloads.platform')}>{d.platform}</td>
                  <td class="p-4" data-label={t('downloads.source')}>{d.source}</td>
                  <td class="p-4" data-label={t('downloads.size')}>{d.size ?? '—'}</td>
                  <td class="p-4 sm:text-right">
                    <a href={d.url} class="btn btn-primary !min-h-0 !py-2" rel="noopener noreferrer" target="_blank">
                      {t('downloads.get')} <span class="sr-only">({t('common.external')})</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState title={t('downloads.emptyTitle')} text={t('downloads.emptyText')} icon="download" />
      )
    }

    {
      pending.length > 0 && (
        <ul class="grid gap-4 sm:grid-cols-2">
          {pending.map((g) => (
            <li class="card flex items-center justify-between gap-4 p-5">
              <div>
                <a href={localePath(lang, gamePath(g))} class="font-bold hover:text-accent-text">{g.title}</a>
                <div class="mt-1.5 flex flex-wrap items-center gap-2 text-sm text-muted">
                  <StatusBadge status={g.status} lang={lang} />
                  <span>{g.platforms.join(', ')}</span>
                </div>
              </div>
              <span class="text-right text-sm text-muted">{t('downloads.comingSoon')}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      storeOnly.length > 0 && (
        <section aria-labelledby="also-on">
          <h2 id="also-on" class="section-title">{t('downloads.alsoOn')}</h2>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2">
            {storeOnly.map((g) => (
              <li class="card flex flex-col gap-4 p-5">
                <div>
                  <a href={localePath(lang, gamePath(g))} class="font-bold hover:text-accent-text">{g.title}</a>
                  <div class="mt-1.5 flex flex-wrap items-center gap-2 text-sm text-muted">
                    <StatusBadge status={g.status} lang={lang} />
                    <span>{g.platforms.join(', ')}</span>
                  </div>
                </div>
                <GameStoreLinks game={g} lang={lang} variant="buttons" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="max-w-3xl rounded-lg border border-line bg-bg-2 p-4 text-sm text-muted">
      <strong class="text-text">⚠</strong>
      {t('downloads.safety')}
      <a href={localePath(lang, '/contact/')} class="link">{t('nav.contact')}</a>
    </p>
  </section>
</BaseLayout>

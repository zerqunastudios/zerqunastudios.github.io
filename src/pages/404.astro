---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../i18n/utils';
---

<BaseLayout lang="en" title="Page not found" path="/" noindex>
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-6xl font-bold text-accent-text">404</p>
    <h1 class="mt-4 text-3xl font-bold">Page not found</h1>
    <p class="mt-2 text-muted">The page you are looking for does not exist or has moved.</p>
    <p class="mt-6 text-lg font-semibold" lang="tr">Sayfa bulunamadı</p>
    <p class="mt-1 text-muted" lang="tr">Aradığınız sayfa mevcut değil veya taşınmış.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={localePath('en', '/')} class="btn btn-primary">Go to the homepage</a>
      <a href={localePath('tr', '/')} class="btn btn-ghost" lang="tr">Ana sayfaya git</a>
    </div>
    <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm">
      <a href={localePath('en', '/support/')} class="link">Support</a>
      <a href={localePath('en', '/privacy-policy/')} class="link">Privacy Policy</a>
      <a href={localePath('tr', '/privacy-policy/')} class="link" lang="tr">Gizlilik Politikası</a>
    </div>
  </section>
</BaseLayout>

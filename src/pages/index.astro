---
// Root URL: send visitors to their language. English is the default.
import { localePath } from '../i18n/utils';
const en = localePath('en', '/');
const tr = localePath('tr', '/');
const site = Astro.site!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Zerquna Studios</title>
    <meta name="description" content="Zerquna Studios — independent game studio." />
    <link rel="canonical" href={new URL(en, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(en, site).href} />
    <link rel="alternate" hreflang="tr" href={new URL(tr, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(en, site).href} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ en, tr }}>
      try {
        var langs = navigator.languages || [navigator.language || ''];
        var target = String(langs[0] || '').toLowerCase().indexOf('tr') === 0 ? tr : en;
        location.replace(target);
      } catch (e) {
        location.replace(en);
      }
    </script>
    <meta http-equiv="refresh" content={`1; url=${en}`} />
    <style>
      body { background: #090b10; color: #f5f5f5; font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: #f5f5f5; margin: 0 .5rem; }
    </style>
  </head>
  <body>
    <p><a href={en}>English</a> · <a href={tr}>Türkçe</a></p>
  </body>
</html>

---
// Responsive image wrapper. Normal art goes through Astro's optimizer
// (WebP + srcset). Pixel art is served untouched at its original size and
// scaled by the browser with `image-rendering: pixelated`, so it stays crisp.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  pixelated?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, alt, pixelated = false, widths, sizes, loading = 'lazy', fetchpriority, class: className } = Astro.props;
---

{
  pixelated ? (
    <img
      src={src.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class:list={[className, 'pixelated']}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
    />
  )
}

---
// Placeholder studio mark. Replace the SVG paths with the official logo when available.
interface Props {
  size?: number;
  withText?: boolean;
  class?: string;
}
const { size = 36, withText = true, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="#141821" stroke="#262C39" stroke-width="2"></rect>
    <path d="M17 17h30v6L27 41h20v6H17v-6l20-18H17z" fill="#F5F5F5"></path>
    <path d="M40 29l7-6v6l-7 6z" fill="#E63946"></path>
  </svg>
  {
    withText && (
      <span class="flex flex-col leading-none">
        <span class="font-bold tracking-[0.18em] text-[0.95rem] text-text">ZERQUNA</span>{' '}
        <span class="mt-1 text-[0.62rem] font-semibold tracking-[0.42em] text-muted">STUDIOS</span>
      </span>
    )
  }
</span>

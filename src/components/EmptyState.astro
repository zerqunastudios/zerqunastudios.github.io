---
interface Props {
  title: string;
  text: string;
  icon?: 'log' | 'download' | 'image';
}
const { title, text, icon = 'log' } = Astro.props;
---

<div class="card flex flex-col items-center px-6 py-14 text-center">
  <div class="flex h-14 w-14 items-center justify-center rounded-full border border-line bg-bg-2 text-accent-text" aria-hidden="true">
    {
      icon === 'log' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 3h9l3 3v15H6z" />
          <path d="M9 10h6M9 14h6M9 18h4" />
        </svg>
      )
    }
    {
      icon === 'download' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
        </svg>
      )
    }
    {
      icon === 'image' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 16l5-5 4 4 3-3 6 6" />
        </svg>
      )
    }
  </div>
  <h2 class="mt-5 text-xl font-bold">{title}</h2>
  <p class="mt-2 max-w-md text-muted">{text}</p>
  <slot />
</div>

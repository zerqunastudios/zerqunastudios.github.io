---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_15%_0%,rgba(230,57,70,0.12),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-site relative py-14 sm:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 text-3xl font-bold sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-base text-muted sm:text-lg">{intro}</p>}
    <slot />
  </div>
</section>

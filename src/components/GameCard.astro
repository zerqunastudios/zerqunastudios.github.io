---
import GameImg from './GameImg.astro';
import StatusBadge from './StatusBadge.astro';
import { gamePath, type Game } from '../data/games';
import type { Locale } from '../data/site';
import { localePath, pick, useTranslations } from '../i18n/utils';

interface Props {
  game: Game;
  lang: Locale;
  headingLevel?: 'h2' | 'h3';
}
const { game, lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const portrait = game.cover.src.height > game.cover.src.width;
---

<article class="card group relative flex flex-col overflow-hidden transition-colors hover:border-muted/50">
  <div class="relative aspect-[16/9] overflow-hidden bg-bg-2">
    {
      portrait && (
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,#2a3242_0%,#141821_70%)]" aria-hidden="true" />
      )
    }
    <GameImg
      src={game.cover.src}
      alt={pick(game.cover.alt, lang)}
      pixelated={game.cover.pixelated}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class={`relative h-full w-full transition-transform duration-500 group-hover:scale-[1.03] ${portrait ? 'object-contain' : 'object-cover'}`}
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <StatusBadge status={game.status} lang={lang} />
      <span class="text-xs text-muted">{pick(game.genre, lang)}</span>
    </div>
    <Heading class="mt-3 text-lg font-bold">
      <a href={localePath(lang, gamePath(game))} class="after:absolute after:inset-0 focus-visible:outline-none">
        {game.title}
      </a>
    </Heading>
    <p class="mt-1.5 text-sm text-muted">{pick(game.tagline, lang)}</p>
    <p class="mt-auto pt-4 text-sm font-semibold text-accent-text" aria-hidden="true">{t('games.view')} →</p>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>

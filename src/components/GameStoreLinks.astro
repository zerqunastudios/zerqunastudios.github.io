---
// Official store links for a game, in two looks:
//  - "buttons": prominent call-to-action buttons (game page hero)
//  - "section": a "Where to Get" block with one card per store
// All links are external: new tab + rel="noopener noreferrer".
import type { Game, StoreLink } from '../data/games';
import type { Locale } from '../data/site';
import { pick, useTranslations } from '../i18n/utils';

interface Props {
  game: Game;
  lang: Locale;
  variant?: 'buttons' | 'section';
  /** Heading level for the section title. */
  headingLevel?: 'h2' | 'h3';
  /** Hide the section heading (when the surrounding page already has one). */
  hideHeading?: boolean;
  class?: string;
}
const { game, lang, variant = 'buttons', headingLevel = 'h2', hideHeading = false, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const label = (s: StoreLink) => (s.label ? pick(s.label, lang) : t('game.getOn').replace('{store}', s.store));
const headingId = `where-to-get-${game.slug}`;
---

{
  variant === 'buttons' ? (
    game.storeLinks.length > 0 ? (
      <div class:list={['flex flex-wrap gap-3', className]}>
        {game.storeLinks.map((s) => (
          <a href={s.url} class="btn btn-primary !px-5 !text-base" rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            </svg>
            {label(s)}
            <span class="sr-only"> ({t('common.external')})</span>
          </a>
        ))}
      </div>
    ) : (
      <p class:list={['text-sm text-muted', className]}>{t('game.storesNone')}</p>
    )
  ) : (
    <section aria-labelledby={hideHeading ? undefined : headingId} aria-label={hideHeading ? t('game.stores') : undefined} class={className}>
      {!hideHeading && (
        <Heading id={headingId} class="section-title">
          {t('game.stores')}
        </Heading>
      )}
      {game.storeLinks.length > 0 ? (
        <ul class:list={['grid gap-4', !hideHeading && 'mt-5']}>
          {game.storeLinks.map((s) => (
            <li class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{s.store}</p>
                <p class="mt-1 font-semibold">{game.title}</p>
                {s.note && <p class="mt-1.5 text-sm text-muted">{pick(s.note, lang)}</p>}
              </div>
              <a href={s.url} class="btn btn-primary shrink-0" rel="noopener noreferrer" target="_blank">
                {label(s)}
                <span aria-hidden="true">↗</span>
                <span class="sr-only"> ({t('common.external')})</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class:list={['text-muted', !hideHeading && 'mt-4']}>{t('game.storesNone')}</p>
      )}
    </section>
  )
}
